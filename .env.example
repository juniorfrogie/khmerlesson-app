EXPO_PUBLIC_API_BASE_URL=http://localhost:5001
EXPO_PUBLIC_API_KEY=your_api_key_here
EXPO_PUBLIC_BUCKET_URL=http://localhost:5001/uploads

# Google Sign-In (app/auth/login.tsx) — Google Cloud Console OAuth client IDs.
# These were read by the code already but undocumented here until this was
# added; find the real values in EAS secrets / whoever set up the Google
# Cloud project, not by inventing new ones.
EXPO_PUBLIC_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
# Google's iOS OAuth client expects its own reversed-ID scheme as the redirect URI.
EXPO_PUBLIC_REVERSED_IOS_CLIENT_ID=com.googleusercontent.apps.your_ios_client_id
